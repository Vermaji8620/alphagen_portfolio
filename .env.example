# Server Environment Variables
PORT=5000
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-url>/?retryWrites=true&w=majority
DB_NAME=alphagen_db

# Optional for single-service deployment (when frontend & backend share same domain):
# FRONTEND_ORIGIN can be left unset when deployed on a single service.
# Set FRONTEND_ORIGIN only if accessing the API from a separate origin during local development:
# FRONTEND_ORIGIN=http://localhost:5173
